# Copy to .env and run with: uv run --env-file .env alpine
# Any OpenAI-compatible server (OpenRouter, vLLM, onerouter, ...):
ALPINE_MODEL=motif/motif-3
ALPINE_BASE_URL=https://llm.onerouter.pro/v1
ALPINE_API_KEY=

# Or a provider-prefixed model with the provider's standard key:
# ALPINE_MODEL=anthropic/claude-sonnet-5
# ANTHROPIC_API_KEY=
